# Opsyra Central — landing site, pricing, sign-up, super admin
# (opsyra.brainstormertech.com). Copy to ~/opsyra/central/shared/.env on the
# server and fill in every <…>. Never commit the real file.

APP_NAME="Opsyra"
APP_ENV=production
APP_KEY=<run: php artisan key:generate --show   (once, then keep it)>
APP_DEBUG=false
APP_URL=https://opsyra.brainstormertech.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Central's own PostgreSQL database (separate from the country's).
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=<cpanelprefix>_opsyra_central
DB_USERNAME=<cpanelprefix>_opsyra
DB_PASSWORD=<database password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<mail.brainstormertech.com>
MAIL_PORT=465
MAIL_USERNAME=<no-reply@brainstormertech.com>
MAIL_PASSWORD=<mailbox password>
MAIL_FROM_ADDRESS=no-reply@brainstormertech.com
MAIL_FROM_NAME="Opsyra"

# The US deployment: where its app lives, and its signed internal API.
# OPSYRA_US_SECRET must equal OPSYRA_CENTRAL_SECRET in the US .env.
OPSYRA_US_URL=https://us.opsyra.brainstormertech.com
OPSYRA_US_API_URL=https://us.opsyra.brainstormertech.com
OPSYRA_US_SECRET=<shared secret>

# Other countries stay empty until they're deployed.
OPSYRA_GB_URL=
OPSYRA_GB_API_URL=
OPSYRA_GB_SECRET=
OPSYRA_OM_URL=
OPSYRA_OM_API_URL=
OPSYRA_OM_SECRET=
OPSYRA_PK_URL=
OPSYRA_PK_API_URL=
OPSYRA_PK_SECRET=
