# Opsyra — US country deployment (us.opsyra.brainstormertech.com)
# Copy to ~/opsyra/us/shared/.env on the server and fill in every <…>.
# Never commit the real file.

APP_NAME=Opsyra
APP_ENV=production
APP_KEY=<run: php artisan key:generate --show   (once, then keep it — changing it breaks encrypted bank details)>
APP_DEBUG=false
APP_URL=https://us.opsyra.brainstormertech.com
# The Vue app is served from the same address.
APP_FRONTEND_URL=https://us.opsyra.brainstormertech.com
APP_COUNTRY=us

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# PostgreSQL, created in cPanel → PostgreSQL Databases. The user must be an
# ordinary cPanel database user — never a superuser (the preflight check
# refuses to deploy otherwise: it would switch off company separation).
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=<cpanelprefix>_opsyra_us
DB_USERNAME=<cpanelprefix>_opsyra
DB_PASSWORD=<database password>

# No Redis needed: sessions, cache and the job queue use the database.
# (If the server has Redis, these can be switched to redis.)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Real email through the server's mail (a mailbox created in cPanel → Email
# Accounts, e.g. no-reply@brainstormertech.com). Only test with addresses you own.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<mail.brainstormertech.com>
MAIL_PORT=465
MAIL_USERNAME=<no-reply@brainstormertech.com>
MAIL_PASSWORD=<mailbox password>
MAIL_FROM_ADDRESS=no-reply@brainstormertech.com
MAIL_FROM_NAME="Opsyra"

# Signed calls from Opsyra Central (sign-ups, subscriptions). A long random
# value; the SAME value goes in Central's OPSYRA_US_SECRET.
# Generate one with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
OPSYRA_CENTRAL_SECRET=<shared secret>
